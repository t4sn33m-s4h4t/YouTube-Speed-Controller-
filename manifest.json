{
  "manifest_version": 3,
  "name": "YT Speed Controller",
  "version": "1.0",
  "description": "Control YouTube video playback speed with keyboard shortcuts",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  }
}